[Compositing]
Backend=OpenGL
GLCore=true
GLPlatformInterface=egl
HiddenPreviews=6
MaxFPS=165
RefreshRate=165
WindowsBlockCompositing=false
ZeroTearing=true
VRREnabled=true
AutoHDR=true

[Wayland]
EnableFractionalScale=true
CustomScaleFactors=1.0,1.25,1.5
MultiHeadIndepentRefresh=true

[RoundCorners]
ActiveCornerRadius=8
InactiveCornerRadius=8
PopupCornerRadius=6
ButtonCornerRadius=4
BorderThickness=1
BorderColor=rgba(255, 255, 255, 0.08)

[Shadows]
ActiveWindowShadowRadius=32
ActiveWindowShadowOpacity=0.60
InactiveWindowShadowRadius=8
InactiveWindowShadowOpacity=0.25

[Windows]
BorderlessMaximizedWindows=true
FocusPolicy=ClickToFocus
SnapToEdges=true
SnapLayoutsEnabled=true
SnapLayoutDelay=500
